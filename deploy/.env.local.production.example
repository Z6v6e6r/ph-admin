# Copy only the live `MONGODB_URI` here on a trusted development Mac.
# This file is ignored by git because that URI includes database credentials.
#
# The local compose file overrides host/port and disables direct outbound
# delivery. It still connects to the live MongoDB, so treat UI mutations as
# production changes.
MONGODB_URI=
MONGODB_DB=dialog
GAMES_MONGODB_DB=games
SUPPORT_MONGODB_DB=dialog
SUPPORT_WEB_MONGODB_DB=games
SUPPORT_MAX_MONGODB_DB=support_max
