# Public API port inside container
PORT=3000

# Set true when running behind nginx/reverse proxy
TRUST_PROXY=true

# Admin auth
ADMIN_AUTH_ENABLED=true
ADMIN_AUTH_REQUIRE_STAFF_TOKEN=true
ADMIN_AUTH_SECRET=change_me_long_random_secret
ADMIN_AUTH_TTL_HOURS=12
# JSON array
# ADMIN_AUTH_USERS_JSON=[{"id":"superadmin-1","login":"superadmin","password":"change_me_password","roles":["SUPER_ADMIN"],"stationIds":[]}]
ADMIN_AUTH_USERS_JSON=
# Optional collection names. The first successful startup seeds built-in roles
# and imports ADMIN_AUTH_USERS_JSON only when admin_users is empty.
ADMIN_AUTH_MONGODB_COLLECTION=admin_users
ADMIN_AUTH_ROLES_MONGODB_COLLECTION=admin_roles
ADMIN_AUTH_AUDIT_MONGODB_COLLECTION=admin_audit_log

# MongoDB (messages, threads, settings persistence)
MONGODB_URI=mongodb://147.45.254.160:27017
MONGODB_DB=ph_admin_portal

# Infrastructure endpoints
PHAB_PUBLIC_BASE_URL=https://padlhub.su
TG_BOT_CORE_URL=http://80.78.255.203:2606/zver
NODE_RED_CORE_URL=http://147.45.103.3:1880

# PadelHub source mode: mock|http
LK_PADELHUB_MODE=mock
LK_PADELHUB_GAMES_URL=
LK_PADELHUB_TOURNAMENTS_URL=
LK_PADELHUB_COMMUNITIES_LIST_URL=
LK_PADELHUB_COMMUNITY_BY_ID_URL_TEMPLATE=
LK_PADELHUB_COMMUNITIES_URL=
LK_PADELHUB_API_TOKEN=
# Server-to-server durable player leave facade. Keep this token only in CUP/LK server env;
# never expose it in the admin panel bundle or browser configuration.
LK_PADELHUB_STAFF_API_BASE_URL=
LK_PADELHUB_STAFF_INTEGRATION_TOKEN=
LK_PADELHUB_STAFF_REQUEST_TIMEOUT_MS=8000

# Communities MongoDB source (preferred in production)
COMMUNITIES_MONGODB_URI=
COMMUNITIES_MONGODB_DB=
COMMUNITIES_MONGODB_COLLECTION=
COMMUNITIES_INVITE_BASE_URL=https://padlhub.ru/community/invite/

# Public tournaments
TOURNAMENTS_PUBLIC_BASE_URL=https://padlhub.su/api/tournaments/public/
TOURNAMENTS_PUBLIC_DIRECTORY_URL=https://padlhub.ru/tournaments
TOURNAMENTS_PUBLIC_REQUIRE_LK_AUTH=true
TOURNAMENTS_PUBLIC_LK_AUTH_URL=https://padlhub.ru/lk_new
TOURNAMENTS_PUBLIC_LK_AUTH_POLL_MS=1500
TOURNAMENTS_PUBLIC_KEYCLOAK_BASE_URL=https://kc.vivacrm.ru
TOURNAMENTS_PUBLIC_KEYCLOAK_REALM=prod
TOURNAMENTS_LK_KEYCLOAK_REALM=clients
TOURNAMENTS_PUBLIC_TENANT_KEY=iSkq6G
TOURNAMENTS_PUBLIC_AUTH_CLIENT_ID=widget
TOURNAMENTS_PUBLIC_AUTH_CHANNEL=cascade
TOURNAMENTS_PUBLIC_AUTH_TIMEOUT_MS=5000
TOURNAMENTS_PUBLIC_SESSION_COOKIE=ph_tournament_client
TOURNAMENTS_PUBLIC_SESSION_SECRET=
TOURNAMENTS_PUBLIC_SESSION_TTL_DAYS=30

# Internal Node-RED -> CUP verifier for LK access tokens. Use the same random
# value in Node-RED CUP_LK_IDENTITY_TOKEN; never expose it to the browser.
LK_IDENTITY_INTEGRATION_TOKEN=
LK_IDENTITY_KEYCLOAK_ISSUER=https://kc.vivacrm.ru/realms/clients
LK_IDENTITY_KEYCLOAK_JWKS_URL=https://kc.vivacrm.ru/realms/clients/protocol/openid-connect/certs
# LK still recognizes retained sessions issued by the former prod realm. Keep
# this as an explicit allowlisted profile with its own JWKS; set issuer empty
# only after prod-realm sessions have been retired.
LK_IDENTITY_LEGACY_KEYCLOAK_ISSUER=https://kc.vivacrm.ru/realms/prod
LK_IDENTITY_LEGACY_KEYCLOAK_JWKS_URL=https://kc.vivacrm.ru/realms/prod/protocol/openid-connect/certs
LK_IDENTITY_LEGACY_EXPECTED_AUDIENCES=widget,account
LK_IDENTITY_LEGACY_EXPECTED_AUTHORIZED_PARTY=widget
LK_IDENTITY_EXPECTED_AUDIENCES=widget,account
LK_IDENTITY_EXPECTED_AUTHORIZED_PARTY=widget
LK_IDENTITY_EXPECTED_TENANT_KEY=iSkq6G
# Logs each enum-only rejection reason once per process; never logs claims or tokens.
LK_IDENTITY_DIAGNOSTICS_ENABLED=false
# Backward-compatible alias for diagnostics during a phased rollout.
LK_IDENTITY_FAILURE_LOG_ENABLED=0
LK_IDENTITY_JWKS_TIMEOUT_MS=5000
LK_IDENTITY_JWKS_CACHE_TTL_MS=600000
LK_IDENTITY_JWKS_STALE_GRACE_MS=3600000
LK_IDENTITY_JWKS_FORCE_REFRESH_MIN_INTERVAL_MS=60000
LK_IDENTITY_CLOCK_SKEW_SECONDS=30

# Viva tournament snapshot read path. Ordinary GET reads Mongo only;
# live Viva refresh is allowed only through bounded, date-scoped actions.
VIVA_GOVERNOR_ENABLED=false
VIVA_REFERENCE_CACHE_ENABLED=false
VIVA_TOURNAMENT_SNAPSHOT_ENABLED=false
VIVA_TOURNAMENT_SNAPSHOT_READ_MODEL=true
# Enables only bounded, date-scoped public list revalidation. It does not start
# the broad background snapshot worker controlled by SNAPSHOT_ENABLED above.
VIVA_TOURNAMENT_SNAPSHOT_PUBLIC_REVALIDATION_ENABLED=true
VIVA_TOURNAMENT_SNAPSHOT_ACTIVE_REFRESH_MS=60000
VIVA_TOURNAMENT_SNAPSHOT_IDLE_REFRESH_MS=300000
VIVA_TOURNAMENT_SNAPSHOT_HYDRATE_RETRY_MS=60000
VIVA_TOURNAMENT_SNAPSHOT_MANUAL_REFRESH_COOLDOWN_MS=15000
TOURNAMENTS_HOSTING_ACCESS_CACHE_TTL_MS=15000
VIVA_END_USER_USER_AGENT=PadlHub-LK-Tournament-Refresh/1.0
VIVA_TOURNAMENT_SNAPSHOT_MONGODB_DB=games
VIVA_REFERENCE_CACHE_STUDIOS_TTL_MS=86400000
VIVA_REFERENCE_CACHE_TRAINERS_TTL_MS=43200000
VIVA_REFERENCE_CACHE_PROFILE_TTL_MS=300000

# Telegram inbound webhook validation (optional)
TELEGRAM_WEBHOOK_SECRET=

# Telegram station mapping JSON (optional override)
# TELEGRAM_STATION_MAPPINGS=[{"key":"yas","stationId":"Yasenevo","stationName":"Ясенево","groupChatId":"-1002248644435"}]
TELEGRAM_STATION_MAPPINGS=

# Outbound delivery mode: outbox (recommended with Node-RED) | direct
TELEGRAM_DELIVERY_MODE=outbox

# Shared token for Node-RED -> API outbox endpoints
TELEGRAM_INTEGRATION_TOKEN=change_me_strong_token

# Bot token is required if TELEGRAM_DELIVERY_MODE=direct
# For outbox mode keep it empty or fill for future direct fallback
TELEGRAM_BOT_TOKEN=

# Managed subscriptions are disabled by default. Test runtime uses fake
# payments only and must point to a separate non-production database.
SUBSCRIPTIONS_ADMIN_ENABLED=false
SUBSCRIPTIONS_TEST_RUNTIME_ENABLED=false
SUBSCRIPTIONS_RUNTIME_CONTRACTS_ENABLED=false
SUBSCRIPTIONS_SHADOW_QUOTE_ENABLED=false
SUBSCRIPTIONS_SHADOW_QUOTE_MAX_STALENESS_SECONDS=
SUBSCRIPTIONS_TRUSTED_SHADOW_ADAPTER_ENABLED=false
SUBSCRIPTIONS_RUNTIME_CONTEXT_ENABLED=false
SUBSCRIPTIONS_RUNTIME_CONTEXT_MAX_STALENESS_SECONDS=
SUBSCRIPTIONS_RUNTIME_CONTEXT_INTEGRATION_TOKEN=
SUBSCRIPTIONS_CANONICAL_TARGET_RESOLVER_ENABLED=false
SUBSCRIPTIONS_SYNTHETIC_CANONICAL_PROJECTION_ENABLED=false
SUBSCRIPTIONS_SYNTHETIC_CANONICAL_STATION_IDS=
SUBSCRIPTIONS_SYNTHETIC_PROJECTION_APPLY=
SUBSCRIPTIONS_SYNTHETIC_PROJECTION_FIXTURE=
SUBSCRIPTIONS_SYNTHETIC_PROJECTION_TARGET_SHA256=
SUBSCRIPTIONS_PROVIDER_CANONICAL_PROJECTION_ENABLED=false
SUBSCRIPTIONS_PROVIDER_CANONICAL_PROJECTION_INPUT=
SUBSCRIPTIONS_PROVIDER_CANONICAL_PROJECTION_APPLY=
SUBSCRIPTIONS_PROVIDER_CANONICAL_PROJECTION_INPUT_SHA256=
SUBSCRIPTIONS_PROVIDER_CANONICAL_APPROVAL_REF=
SUBSCRIPTIONS_PROVIDER_CANONICAL_STATION_IDS=
SUBSCRIPTIONS_SHADOW_QUOTE_INTEGRATION_TOKEN=
SUBSCRIPTIONS_RUNTIME_TENANT_ID=
SUBSCRIPTIONS_RUNTIME_HASH_PEPPER=
SUBSCRIPTIONS_PROVIDER_MAPPING_PREVIEW_ENABLED=false
SUBSCRIPTIONS_PROVIDER_MAPPING_PREVIEW_CLIENT_ID=
SUBSCRIPTIONS_PUBLICATION_PREVIEW_ENABLED=false
SUBSCRIPTIONS_PUBLICATION_COMMAND_ENABLED=false
SUBSCRIPTIONS_MONGODB_URI=
SUBSCRIPTIONS_MONGODB_DB=
SUBSCRIPTIONS_AUTO_CREATE_INDEXES=false
SUBSCRIPTIONS_TEST_HASH_PEPPER=

# Referral links admin and public redirect. Keep disabled until the additive
# indexes are applied and the LK checkout attribution fields are released.
REFERRAL_LINKS_ENABLED=false
REFERRAL_LINKS_PUBLIC_BASE_URL=https://padlhub.su
REFERRAL_LINKS_ALLOWED_ORIGINS=https://padlhub.ru,https://www.padlhub.ru,https://padlhub.su
REFERRAL_LINKS_MONGODB_URI=
REFERRAL_LINKS_MONGODB_DB=
REFERRAL_LINKS_AUTO_CREATE_INDEXES=false
