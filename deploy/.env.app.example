# Public API port inside container
PORT=3000

# Set true when running behind nginx/reverse proxy
TRUST_PROXY=true

# Admin auth
ADMIN_AUTH_ENABLED=true
ADMIN_AUTH_REQUIRE_STAFF_TOKEN=true
ADMIN_AUTH_SECRET=change_me_long_random_secret
ADMIN_AUTH_TTL_HOURS=12
# JSON array
# ADMIN_AUTH_USERS_JSON=[{"id":"superadmin-1","login":"superadmin","password":"change_me_password","roles":["SUPER_ADMIN"],"stationIds":[]}]
ADMIN_AUTH_USERS_JSON=
# Optional collection names. Non-production startup seeds built-in roles and
# imports ADMIN_AUTH_USERS_JSON when admin_users is empty. Production startup is
# read-only: provision persistent users/roles through an explicit guarded action.
ADMIN_AUTH_MONGODB_COLLECTION=admin_users
ADMIN_AUTH_ROLES_MONGODB_COLLECTION=admin_roles
ADMIN_AUTH_AUDIT_MONGODB_COLLECTION=admin_audit_log

# MongoDB (messages, threads, settings persistence)
MONGODB_URI=mongodb://147.45.254.160:27017
MONGODB_DB=ph_admin_portal

# Infrastructure endpoints
PHAB_PUBLIC_BASE_URL=https://padlhub.su
TG_BOT_CORE_URL=http://80.78.255.203:2606/zver
NODE_RED_CORE_URL=http://147.45.103.3:1880

# PadelHub source mode: mock|http
LK_PADELHUB_MODE=mock
LK_PADELHUB_GAMES_URL=
LK_PADELHUB_TOURNAMENTS_URL=
LK_PADELHUB_COMMUNITIES_LIST_URL=
LK_PADELHUB_COMMUNITY_BY_ID_URL_TEMPLATE=
LK_PADELHUB_COMMUNITIES_URL=
LK_PADELHUB_API_TOKEN=
# Server-to-server durable player leave facade. Keep this token only in CUP/LK server env;
# never expose it in the admin panel bundle or browser configuration.
LK_PADELHUB_STAFF_API_BASE_URL=
LK_PADELHUB_STAFF_INTEGRATION_TOKEN=
LK_PADELHUB_STAFF_REQUEST_TIMEOUT_MS=8000

# Communities MongoDB source (preferred in production)
COMMUNITIES_MONGODB_URI=
COMMUNITIES_MONGODB_DB=
COMMUNITIES_MONGODB_COLLECTION=
COMMUNITIES_INVITE_BASE_URL=https://padlhub.ru/community/invite/

# Public tournaments
TOURNAMENTS_PUBLIC_BASE_URL=https://padlhub.su/api/tournaments/public/
TOURNAMENTS_PUBLIC_DIRECTORY_URL=https://padlhub.ru/tournaments
TOURNAMENTS_PUBLIC_REQUIRE_LK_AUTH=true
TOURNAMENTS_PUBLIC_LK_AUTH_URL=https://padlhub.ru/lk_new
TOURNAMENTS_PUBLIC_LK_AUTH_POLL_MS=1500
TOURNAMENTS_PUBLIC_KEYCLOAK_BASE_URL=https://kc.vivacrm.ru
TOURNAMENTS_PUBLIC_KEYCLOAK_REALM=prod
TOURNAMENTS_LK_KEYCLOAK_REALM=clients
TOURNAMENTS_PUBLIC_TENANT_KEY=iSkq6G
TOURNAMENTS_PUBLIC_AUTH_CLIENT_ID=widget
TOURNAMENTS_PUBLIC_AUTH_CHANNEL=cascade
TOURNAMENTS_PUBLIC_AUTH_TIMEOUT_MS=5000
TOURNAMENTS_PUBLIC_SESSION_COOKIE=ph_tournament_client
TOURNAMENTS_PUBLIC_SESSION_SECRET=
TOURNAMENTS_PUBLIC_SESSION_TTL_DAYS=30

# Internal Node-RED -> CUP verifier for LK access tokens. Use the same random
# value in Node-RED CUP_LK_IDENTITY_TOKEN; never expose it to the browser.
LK_IDENTITY_INTEGRATION_TOKEN=
LK_IDENTITY_KEYCLOAK_ISSUER=https://kc.vivacrm.ru/realms/clients
LK_IDENTITY_KEYCLOAK_JWKS_URL=https://kc.vivacrm.ru/realms/clients/protocol/openid-connect/certs
# LK still recognizes retained sessions issued by the former prod realm. Keep
# this as an explicit allowlisted profile with its own JWKS; set issuer empty
# only after prod-realm sessions have been retired.
LK_IDENTITY_LEGACY_KEYCLOAK_ISSUER=https://kc.vivacrm.ru/realms/prod
LK_IDENTITY_LEGACY_KEYCLOAK_JWKS_URL=https://kc.vivacrm.ru/realms/prod/protocol/openid-connect/certs
LK_IDENTITY_LEGACY_EXPECTED_AUDIENCES=widget,account
LK_IDENTITY_LEGACY_EXPECTED_AUTHORIZED_PARTY=widget
LK_IDENTITY_EXPECTED_AUDIENCES=widget,account
LK_IDENTITY_EXPECTED_AUTHORIZED_PARTY=widget
LK_IDENTITY_EXPECTED_TENANT_KEY=iSkq6G
# Logs each enum-only rejection reason once per process; never logs claims or tokens.
LK_IDENTITY_DIAGNOSTICS_ENABLED=false
# Backward-compatible alias for diagnostics during a phased rollout.
LK_IDENTITY_FAILURE_LOG_ENABLED=0
LK_IDENTITY_JWKS_TIMEOUT_MS=5000
LK_IDENTITY_JWKS_CACHE_TTL_MS=600000
LK_IDENTITY_JWKS_STALE_GRACE_MS=3600000
LK_IDENTITY_JWKS_FORCE_REFRESH_MIN_INTERVAL_MS=60000
LK_IDENTITY_CLOCK_SKEW_SECONDS=30

# Viva tournament snapshot read path. Ordinary GET reads Mongo only;
# live Viva refresh is allowed only through bounded, date-scoped actions.
VIVA_GOVERNOR_ENABLED=false
VIVA_REFERENCE_CACHE_ENABLED=false
VIVA_TOURNAMENT_SNAPSHOT_ENABLED=false
VIVA_TOURNAMENT_SNAPSHOT_READ_MODEL=true
# Enables only bounded, date-scoped public list revalidation. It does not start
# the broad background snapshot worker controlled by SNAPSHOT_ENABLED above.
VIVA_TOURNAMENT_SNAPSHOT_PUBLIC_REVALIDATION_ENABLED=false
VIVA_TOURNAMENT_SNAPSHOT_ACTIVE_REFRESH_MS=60000
VIVA_TOURNAMENT_SNAPSHOT_IDLE_REFRESH_MS=300000
VIVA_TOURNAMENT_SNAPSHOT_HYDRATE_RETRY_MS=60000
VIVA_TOURNAMENT_SNAPSHOT_MANUAL_REFRESH_COOLDOWN_MS=15000
# Hourly cancellation reconciliation stays enabled by default. Its immediate
# startup run is disabled by default in production and requires explicit opt-in.
TOURNAMENTS_VIVA_STATUS_SYNC_INTERVAL_MS=3600000
TOURNAMENTS_VIVA_STATUS_SYNC_RUN_ON_STARTUP=false
# Automatic no-reply actions can persist messages and call connectors. Production
# startup keeps both Messenger and Support sweeps off until explicitly enabled.
QUICK_REPLIES_NO_REPLY_SWEEP_ENABLED=false
SUPPORT_PERSISTENCE_SYNC_INTERVAL_MS=0
PADLHUB_PLAYER_LEVEL_PROJECTION_ENABLED=false
TOURNAMENTS_HOSTING_ACCESS_CACHE_TTL_MS=15000
VIVA_END_USER_USER_AGENT=PadlHub-LK-Tournament-Refresh/1.0
VIVA_TOURNAMENT_SNAPSHOT_MONGODB_DB=games
VIVA_REFERENCE_CACHE_STUDIOS_TTL_MS=86400000
VIVA_REFERENCE_CACHE_TRAINERS_TTL_MS=43200000
VIVA_REFERENCE_CACHE_PROFILE_TTL_MS=300000

# Telegram inbound webhook validation (optional)
TELEGRAM_WEBHOOK_SECRET=

# Telegram station mapping JSON (optional override)
# TELEGRAM_STATION_MAPPINGS=[{"key":"yas","stationId":"Yasenevo","stationName":"Ясенево","groupChatId":"-1002248644435"}]
TELEGRAM_STATION_MAPPINGS=

# Outbound delivery mode: outbox (recommended with Node-RED) | direct
TELEGRAM_DELIVERY_MODE=outbox

# Shared token for Node-RED -> API outbox endpoints
TELEGRAM_INTEGRATION_TOKEN=change_me_strong_token

# Bot token is required if TELEGRAM_DELIVERY_MODE=direct
# For outbox mode keep it empty or fill for future direct fallback
TELEGRAM_BOT_TOKEN=

# Managed subscriptions are disabled by default. Test runtime uses fake
# payments only and must point to a separate non-production database.
SUBSCRIPTIONS_ADMIN_ENABLED=false
SUBSCRIPTIONS_TEST_RUNTIME_ENABLED=false
SUBSCRIPTIONS_TEST_USAGE_EXACT_TARGETS_JSON=
SUBSCRIPTIONS_RUNTIME_CONTRACTS_ENABLED=false
SUBSCRIPTIONS_INSTANCE_PROJECTOR_CONTRACTS_ENABLED=false
SUBSCRIPTIONS_INSTANCE_PROJECTOR_READINESS_ENABLED=false
SUBSCRIPTIONS_BINDING_PROMOTION_CONTRACTS_ENABLED=false
SUBSCRIPTIONS_INSTANCE_PROJECTOR_INPUT=
SUBSCRIPTIONS_INSTANCE_PROJECTOR_MAX_STALENESS_SECONDS=
SUBSCRIPTIONS_INSTANCE_PROJECTOR_INPUT_SHA256=
SUBSCRIPTIONS_INSTANCE_PROJECTOR_PLAN_SHA256=
SUBSCRIPTIONS_INSTANCE_PROJECTOR_APPROVAL_REF=
SUBSCRIPTIONS_INSTANCE_PROJECTOR_PROVIDER_PRODUCT_ID=
SUBSCRIPTIONS_INSTANCE_PROJECTOR_SCOPE_KIND=
SUBSCRIPTIONS_INSTANCE_PROJECTOR_SCOPE_ID=
SUBSCRIPTIONS_INSTANCE_PROJECTOR_EXPECTED_DB=
SUBSCRIPTIONS_INSTANCE_PROJECTOR_TARGET_SHA256=
SUBSCRIPTIONS_SHADOW_QUOTE_ENABLED=false
SUBSCRIPTIONS_SHADOW_QUOTE_MAX_STALENESS_SECONDS=
SUBSCRIPTIONS_TRUSTED_SHADOW_ADAPTER_ENABLED=false
SUBSCRIPTIONS_RUNTIME_CONTEXT_ENABLED=false
SUBSCRIPTIONS_RUNTIME_CONTEXT_MAX_STALENESS_SECONDS=
SUBSCRIPTIONS_RUNTIME_CONTEXT_INTEGRATION_TOKEN=
# Read-only operator registry over published policy versions. Disabled by default;
# requires an integration token of at least 32 characters. Reads persisted
# publications, instances and decisions only and never evaluates or mutates policy.
SUBSCRIPTIONS_POLICY_REGISTRY_ENABLED=false
SUBSCRIPTIONS_POLICY_REGISTRY_INTEGRATION_TOKEN=
# LK2-facing managed-subscription quote. Disabled by default. Requires the
# recipient public keys, issuer/audience/tenant binding and an integration token.
# The endpoint only accepts LK2's short-lived actor delegation and never trusts
# caller-supplied actor, provider, price or policy values.
SUBSCRIPTIONS_LK2_QUOTE_ENABLED=false
SUBSCRIPTIONS_LK2_QUOTE_INTEGRATION_TOKEN=
SUBSCRIPTIONS_LK2_DELEGATION_PUBLIC_KEYS=
SUBSCRIPTIONS_LK2_DELEGATION_ISSUER=
SUBSCRIPTIONS_LK2_DELEGATION_AUDIENCE=
SUBSCRIPTIONS_LK2_DELEGATION_TENANT_ID=
SUBSCRIPTIONS_LK2_DELEGATION_MAX_TTL_SECONDS=60
SUBSCRIPTIONS_LK2_DELEGATION_CLOCK_TOLERANCE_SECONDS=5
SUBSCRIPTIONS_SALE_READINESS_ENABLED=false
SUBSCRIPTIONS_SALE_READINESS_INTEGRATION_TOKEN=
SUBSCRIPTIONS_INDEX_EXPECTED_DB=
SUBSCRIPTIONS_INDEX_TARGET_SHA256=
SUBSCRIPTIONS_CANONICAL_TARGET_RESOLVER_ENABLED=false
SUBSCRIPTIONS_SYNTHETIC_CANONICAL_PROJECTION_ENABLED=false
SUBSCRIPTIONS_SYNTHETIC_CANONICAL_STATION_IDS=
SUBSCRIPTIONS_SYNTHETIC_PROJECTION_APPLY=
SUBSCRIPTIONS_SYNTHETIC_PROJECTION_FIXTURE=
SUBSCRIPTIONS_SYNTHETIC_PROJECTION_TARGET_SHA256=
SUBSCRIPTIONS_PROVIDER_CANONICAL_PROJECTION_ENABLED=false
SUBSCRIPTIONS_PROVIDER_CANONICAL_PROJECTION_INPUT=
SUBSCRIPTIONS_PROVIDER_CANONICAL_PROJECTION_APPLY=
SUBSCRIPTIONS_PROVIDER_CANONICAL_PROJECTION_INPUT_SHA256=
SUBSCRIPTIONS_PROVIDER_CANONICAL_APPROVAL_REF=
SUBSCRIPTIONS_PROVIDER_CANONICAL_STATION_IDS=
SUBSCRIPTIONS_SHADOW_QUOTE_INTEGRATION_TOKEN=
SUBSCRIPTIONS_ENTITLEMENT_RESERVATION_ENABLED=false
SUBSCRIPTIONS_ACTIVATION_ENABLED=false
SUBSCRIPTIONS_ACTIVATION_DEADLINE_WORKER_ENABLED=false
SUBSCRIPTIONS_ENTITLEMENT_INTEGRATION_TOKEN=
# Owner-attested booking confirmation. Strict mode requires a short-lived
# HMAC attestation of operationId + providerBookingId from the booking owner;
# a bare caller-supplied provider booking id is never sufficient.
SUBSCRIPTIONS_OWNER_EVIDENCE_STRICT=false
SUBSCRIPTIONS_OWNER_EVIDENCE_SECRET=
SUBSCRIPTIONS_OWNER_EVIDENCE_MAX_AGE_SECONDS=60
# Server-to-server canonical activity target intake for LK2 (facts already
# resolved by the activity owner: station, duration, start, confirmed base price,
# evidence refs). Disabled by default; no actor identity, evaluation or booking.
SUBSCRIPTIONS_TARGET_INGEST_ENABLED=false
SUBSCRIPTIONS_TARGET_INGEST_INTEGRATION_TOKEN=
# Best-effort journal of advisory LK1 trusted shadow-quote decisions; the
# financial decision is still recorded on reserve/confirm.
SUBSCRIPTIONS_LK1_QUOTE_JOURNAL_ENABLED=false
SUBSCRIPTIONS_RUNTIME_TENANT_ID=
SUBSCRIPTIONS_RUNTIME_HASH_PEPPER=
SUBSCRIPTIONS_PROVIDER_MAPPING_PREVIEW_ENABLED=false
SUBSCRIPTIONS_PROVIDER_MAPPING_PREVIEW_CLIENT_ID=
SUBSCRIPTIONS_PUBLICATION_PREVIEW_ENABLED=false
SUBSCRIPTIONS_PUBLICATION_COMMAND_ENABLED=false
SUBSCRIPTIONS_MONGODB_URI=
SUBSCRIPTIONS_MONGODB_DB=
SUBSCRIPTIONS_AUTO_CREATE_INDEXES=false
SUBSCRIPTIONS_TEST_HASH_PEPPER=

# Resident personal QR pass and physical service issuance (towel + returnable
# racket) inside the existing subscription contour. Disabled by default. The
# pass token is stored as an HMAC hash only; QR payload contains no PII.
# Issuance is denied unless an explicit CUP benefit rule exists for the
# subscription type, service and station. No default "free towel" or
# "one racket per day" is seeded.
RESIDENT_SERVICES_ENABLED=false
RESIDENT_SERVICES_INTEGRATION_TOKEN=
RESIDENT_SERVICES_TOKEN_PEPPER=
# Fallbacks: SUBSCRIPTIONS_RUNTIME_TENANT_ID and
# SUBSCRIPTIONS_RUNTIME_CONTEXT_MAX_STALENESS_SECONDS.
RESIDENT_SERVICES_TENANT_ID=
RESIDENT_SERVICES_MAX_EVIDENCE_AGE_SECONDS=
# 30..120 seconds; the pass never outlives the confirmed residency term.
RESIDENT_SERVICES_PASS_TTL_SECONDS=120
# Fallbacks: SUBSCRIPTIONS_MONGODB_URI/DB and MONGODB_URI/DB.
RESIDENT_SERVICES_MONGODB_URI=
RESIDENT_SERVICES_MONGODB_DB=
RESIDENT_SERVICES_AUTO_CREATE_INDEXES=false
RESIDENT_SERVICES_PASSES_COLLECTION=cup_resident_passes
RESIDENT_SERVICES_BENEFIT_RULES_COLLECTION=cup_resident_benefit_rules
RESIDENT_SERVICES_USAGE_COLLECTION=cup_resident_service_usage
RESIDENT_SERVICES_ISSUANCES_COLLECTION=cup_resident_service_issuances
RESIDENT_SERVICES_RETURNS_COLLECTION=cup_resident_service_returns
RESIDENT_SERVICES_JOURNAL_COLLECTION=cup_resident_service_journal
# Trusted CUP admin origins for cookie-auth mutations (CSRF guard).
RESIDENT_SERVICES_ADMIN_ORIGINS=https://padlhub.su

# Referral links admin and public redirect. Keep disabled until the additive
# indexes are applied and the LK checkout attribution fields are released.
REFERRAL_LINKS_ENABLED=false
REFERRAL_LINKS_PUBLIC_BASE_URL=https://padlhub.su
REFERRAL_LINKS_ALLOWED_ORIGINS=https://padlhub.ru,https://www.padlhub.ru,https://padlhub.su
REFERRAL_LINKS_MONGODB_URI=
REFERRAL_LINKS_MONGODB_DB=
REFERRAL_LINKS_AUTO_CREATE_INDEXES=false

# Mobile resident check screen (/api/ui/admin/residency/check). Source feature,
# disabled by default. Production requires RESIDENT_SERVICES_ENABLED=true and
# resident-services benefit rules; this screen only composes the staff journey.
RESIDENCY_CHECK_ENABLED=false
RESIDENCY_CHECK_DEMO_MODE=false
# The station where the staff member performs the check. Used when the staff
# account is not scoped to exactly one station. Optional JSON labels:
# {"station-id":"Ясенево"}
RESIDENCY_CHECK_DEFAULT_STATION_ID=
RESIDENCY_CHECK_STATION_LABELS=
# --- Постоянные QR-ссылки ЦУП (раздел «QR-коды») ---
# Выключено по умолчанию. Включать отдельным согласованным шагом после
# применения индексов (npm run qr-links:indexes:apply) и патча nginx /q/.
QR_LINKS_ENABLED=false
QR_LINKS_PUBLIC_BASE_URL=https://padlhub.su
QR_LINKS_ALLOWED_TARGET_HOSTS=padlhub.su,www.padlhub.su,padlhub.ru,www.padlhub.ru
QR_LINKS_ALLOWED_TARGET_PORTS=443
QR_LINKS_ADMIN_ORIGINS=https://padlhub.su
QR_LINKS_MONGODB_URI=
QR_LINKS_MONGODB_DB=
QR_LINKS_COLLECTION=cup_qr_links
QR_LINKS_DAILY_STATS_COLLECTION=cup_qr_daily_stats
QR_LINKS_SETTINGS_COLLECTION=cup_qr_settings
QR_LINKS_STATS_WRITE_TIMEOUT_MS=750
QR_LINKS_ALLOWED_HOSTS_CACHE_TTL_MS=5000
# Необязательно: дополнительные собственные хосты, где /q/* уже управляется.
# QR_LINKS_SELF_HOSTS=
# Compatibility defaults: enable separately after dependency/runtime acceptance.
SUPPORT_MAX_OUTBOX_MODE=legacy
PHAB_LOCATION_PHOTOS_ENABLED=false
PHAB_NOTIFICATION_SCENARIOS_ENABLED=false
PHAB_COMMUNITY_POLICIES_ENABLED=false

# Explicit typed-community allowlist; FRIENDS always remains available.
PHAB_COMMUNITY_POLICY_TYPES_ENABLED=

# Residency monetary booking context. Default off; requires separately reviewed publication/readers.
SUBSCRIPTIONS_RESIDENCY_BOOKING_CONTEXT_ENABLED=false
# Explicit, caller-owned Viva read + fenced observation refresh; does not enable booking itself.
SUBSCRIPTIONS_RESIDENCY_SYNC_ENABLED=false
# Verified Viva studio context for the all-station product card; no fallback/station list.
SUBSCRIPTIONS_RESIDENCY_SYNC_STUDIO_ID=
