{
  "name": "ph-admin-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Starter NestJS backend for games/tournaments admin panel with messenger and RBAC",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run build:client-sdk",
    "build:client-sdk": "node scripts/copy-client-sdk.mjs",
  "audit:indexes:dialogs": "node scripts/dialogs-index-audit.mjs --strict",
  "tournaments:pending-payments:reconcile": "node scripts/reconcile-public-tournament-pending-payments.mjs",
    "subscriptions:indexes:check": "node scripts/managed-subscriptions-indexes.mjs --check",
    "subscriptions:indexes:apply": "node scripts/managed-subscriptions-indexes.mjs --apply",
    "subscriptions:annual-v2:check": "ts-node scripts/managed-subscriptions-annual-v2-candidates.ts --check",
    "subscriptions:backup:target-fingerprint": "node scripts/managed-subscriptions-backup.mjs --target-fingerprint",
    "subscriptions:backup:check": "node scripts/managed-subscriptions-backup.mjs --check",
    "subscriptions:backup:create": "node scripts/managed-subscriptions-backup.mjs --create",
    "subscriptions:synthetic-projection:check": "ts-node scripts/managed-subscriptions-synthetic-projection.ts --check",
    "subscriptions:synthetic-projection:apply": "ts-node scripts/managed-subscriptions-synthetic-projection.ts --apply",
    "subscriptions:synthetic-projection:target-fingerprint": "ts-node scripts/managed-subscriptions-synthetic-projection.ts --target-fingerprint",
    "subscriptions:provider-projection:input-fingerprint": "ts-node scripts/managed-subscriptions-provider-projection.ts --input-fingerprint",
    "subscriptions:provider-projection:check": "ts-node scripts/managed-subscriptions-provider-projection.ts --check",
    "subscriptions:synthetic-indexes:check": "ts-node scripts/managed-subscriptions-synthetic-indexes.ts --check",
    "subscriptions:synthetic-indexes:apply": "ts-node scripts/managed-subscriptions-synthetic-indexes.ts --apply",
    "postcheck:viva-shadow": "node scripts/viva-shadow-postcheck.mjs",
    "support:cleanup-outbox": "node scripts/support-outbox-cleanup.mjs",
    "test:americano-schedule": "ts-node test/americano-schedule.test.ts",
    "test:americano-rating-simulation": "ts-node test/americano-rating-simulation.test.ts",
    "test:tournaments-pricing-snapshot": "ts-node test/tournaments-pricing-snapshot.test.ts",
    "test:tournament-results-export": "ts-node test/tournament-results-export.test.ts",
    "test:tournament-results-store": "ts-node test/tournament-results-store.test.ts",
    "test:support-client-resolve": "ts-node test/support-client-resolve.test.ts",
    "test:support-station-mappings": "ts-node test/support-station-mappings.test.ts",
    "test:support-dialog-resolution": "ts-node test/support-dialog-resolution.test.ts",
    "test:support-outbox-max-attempts": "ts-node test/support-outbox-max-attempts.test.ts",
    "test:auth-rbac": "ts-node test/auth-rbac.test.ts && ts-node test/admin-ui-auth-isolation.test.ts",
    "test:lk-identity": "ts-node test/lk-identity.service.test.ts",
    "test:tournaments-public-auth": "ts-node test/tournaments-public-auth-redirect.test.ts && node --test test/tournaments-showcase-standard-auth.test.mjs && node --test test/tournament-public-nginx-patch.test.mjs",
    "test:player-ratings": "ts-node test/player-ratings.service.test.ts && ts-node test/player-level-projection.service.test.ts && ts-node test/player-level-projection-outbox.test.ts",
    "test:subscriptions": "ts-node test/subscriptions.service.test.ts",
    "test:subscriptions-annual-v2": "ts-node test/managed-annual-subscriptions-v2-candidates.test.ts",
    "test:subscriptions-runtime-contracts": "ts-node test/subscriptions-runtime-contracts.test.ts",
    "test:subscriptions-runtime-v1-quote": "ts-node test/subscriptions-runtime-v1-quote.service.test.ts",
    "test:subscriptions-entitlement-reservation": "ts-node test/subscriptions-entitlement-reservation.repository.test.ts",
    "test:subscriptions-publication": "ts-node test/subscriptions-publication.service.test.ts",
    "test:subscriptions-backup": "node --test test/managed-subscriptions-backup.test.mjs",
    "test:subscriptions-shadow-quote": "ts-node test/subscriptions-shadow-quote.test.ts",
    "test:subscriptions-canonical-target-resolver": "ts-node test/subscriptions-canonical-target-resolver.test.ts",
    "test:subscriptions-synthetic-projection": "ts-node test/subscriptions-synthetic-canonical-projection.test.ts",
    "test:subscriptions-provider-projection": "ts-node test/subscriptions-provider-canonical-projection.test.ts",
    "test:subscriptions-synthetic-projection:mongo": "ts-node test/subscriptions-synthetic-canonical-projection.mongodb.test.ts",
    "test:subscriptions-trusted-shadow-adapter": "ts-node test/subscriptions-trusted-shadow-adapter.test.ts",
    "test:subscriptions-runtime-context": "ts-node test/subscriptions-runtime-context.test.ts",
    "test:subscriptions-runtime": "ts-node test/subscriptions-test-runtime.service.test.ts && ts-node test/subscriptions-test-runtime-ui.test.ts && npm run test:subscriptions-runtime:mongo",
    "test:subscriptions-runtime:mongo": "ts-node test/subscriptions-test-runtime.mongodb.test.ts",
    "test:advertising-card-assets": "ts-node test/advertising-card-assets-and-insights.test.ts",
    "start": "node dist/main.js",
    "start:dev": "ts-node src/main.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.2",
    "@nestjs/core": "^10.4.2",
    "@nestjs/platform-express": "^10.4.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "exceljs": "^4.4.0",
    "mongodb": "^6.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
