          <mxGeometry x="45" y="490" width="350" height="85" as="geometry" />
        </mxCell>
        <mxCell id="24" value="Telegram / MAX / LK&#xa;Node-RED только как adapter до замены критичных flow на workers" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="20">
          <mxGeometry x="45" y="640" width="350" height="85" as="geometry" />
        </mxCell>
        <mxCell id="25" value="Контроль перехода: каждый агрегат имеет owner, external_id, версию, watermark; dual-write запрещён. Cutover только после сверки данных и E2E-probe." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1;" vertex="1" parent="1">
