          <mxGeometry x="45" y="80" width="350" height="110" as="geometry" />
        </mxCell>
        <mxCell id="22" value="Viva CRM&#xa;временно владеет неперенесёнными агрегатами&#xa;после switch: read-only и архив" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;fontStyle=1;" vertex="1" parent="20">
