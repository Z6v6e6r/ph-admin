        <mxCell id="16" value="PostgreSQL&#xa;канонические транзакционные данные&#xa;один writer на aggregate" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="15">
